# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Production (EC2 /opt/weepark/backend/.env):
# NODE_ENV=production
# API_URL=https://api-qr.weepark.in
# CLIENT_URL=<frontend origin, e.g. http://localhost:5173 until the UI is hosted>

# Database (local docker-compose postgres on host port 5434)
# Production MUST use unique credentials — weepark/weepark is rejected when NODE_ENV=production.
DATABASE_URL=postgresql://weepark:weepark@localhost:5434/weepark?schema=public

# JWT — generate two distinct random strings of at least 32 characters.
# Placeholders containing "change-me" are rejected at startup.
JWT_ACCESS_SECRET=generate_a_random_string_at_least_32_chars_aa
JWT_REFRESH_SECRET=generate_a_different_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin seed (required). Existing users are never password-reset by seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=set_a_strong_password_12plus

# Email (SMTP) - leave SMTP_HOST empty to skip sending in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="weepark <no-reply@weepark.in>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Set true only behind a TLS terminator in production (enables HSTS + HTTP→HTTPS).
ENFORCE_HTTPS=false
